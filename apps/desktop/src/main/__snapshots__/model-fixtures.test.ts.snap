  "model {"id":"rocket","x":40,"y":40,"w":640,"h":600,"title":"Inside a two-stage rocket","turntable":true}",
  "part {"id":"rocket","name":"stage1","shape":"tube","dimensions":{"r":0.4,"inner":0.36800000000000005,"h":2},"at":[0,-0.8,0],"turn":[0,0,0],"scale":1,"copies":1,"step":[0,0,0],"around":false,"mat":"paint","half":false,"color":"white"}",
  "part {"id":"rocket","name":"stage2","shape":"tube","dimensions":{"r":0.4,"inner":0.36800000000000005,"h":1.2},"at":[0,0.9,0],"turn":[0,0,0],"scale":1,"copies":1,"step":[0,0,0],"around":false,"mat":"paint","half":false,"color":"white"}",
