  "part {"id":"rocket","name":"oxidizer","shape":"capsule","dimensions":{"r":0.34,"h":0.9},"at":[0,-1.3,0],"turn":[0,0,0],"scale":1,"copies":1,"step":[0,0,0],"around":false,"mat":"steel","half":false,"color":"blue"}",
  "tag {"id":"rocket","part":"fuel","text":"Fuel tank","side":"left"}",
  "tag {"id":"rocket","part":"oxidizer","text":"Oxidizer tank","side":"left"}",
  "part {"id":"rocket","name":"engine","shape":"lathe","dimensions":{},"at":[0,0,0],"turn":[0,0,0],"scale":1,"copies":1,"step":[0,0,0],"around":false,"mat":"steel","half":false,"profile":[[0.1,-1.85],[0.18,-2.1],[0.32,-2.4]]}",
  "part {"id":"rocket","name":"fins","shape":"box","dimensions":{"w":0.35,"h":0.6,"d":0.04,"round":0},"at":[0.5,-1.6,0],"turn":[0,0,0],"scale":1,"copies":4,"step":[0,0,0],"around":true,"mat":"paint","half":false,"color":"grey"}",
  "part {"id":"rocket","name":"flame","shape":"cone","dimensions":{"r":0.28,"h":0.8},"at":[0,-2.8,0],"turn":[180,0,0],"scale":1,"copies":1,"step":[0,0,0],"around":false,"mat":"glow","half":false,"color":"orange"}",
  "tag {"id":"rocket","part":"engine","text":"Engine bell","side":"right"}",
  "part {"id":"rocket","name":"interstage","shape":"cylinder","dimensions":{"r":0.4,"h":0.15,"top":0.4},"at":[0,0.25,0],"turn":[0,0,0],"scale":1,"copies":1,"step":[0,0,0],"around":false,"mat":"steel","half":false}",
  "part {"id":"rocket","name":"upper","shape":"capsule","dimensions":{"r":0.3,"h":0.7},"at":[0,0.75,0],"turn":[0,0,0],"scale":1,"copies":1,"step":[0,0,0],"around":false,"mat":"steel","half":false}",
  "part {"id":"rocket","name":"payload","shape":"sphere","dimensions":{"r":0.25},"at":[0,1.75,0],"turn":[0,0,0],"scale":1,"copies":1,"step":[0,0,0],"around":false,"mat":"brass","half":false}",
  "tag {"id":"rocket","part":"payload","text":"Payload","side":"right"}",
  "tag {"id":"rocket","part":"interstage","text":"Interstage","side":"right"}",
