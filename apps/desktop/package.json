{
  "name": "@heynimbo/desktop",
  "productName": "HeyNimbo",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "node ../../scripts/prepare-dev-speech-permissions.cjs && electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "brand": "electron scripts/brand.cjs",
    "dist:mac": "pnpm build && electron-builder --mac dir --arm64"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.91",
    "@ai-sdk/deepseek": "3.0.75",
    "@ai-sdk/google": "4.0.107",
    "@ai-sdk/openai": "4.0.104",
    "@ai-sdk/openai-compatible": "3.0.80",
    "@heynimbo/native": "workspace:*",
    "@openrouter/ai-sdk-provider": "3.1.0",
    "ai": "7.0.156",
    "jose": "6.2.14",
    "perfect-freehand": "^1.2.3",
    "three": "^0.186.1",
    "ws": "^8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "5.0.5",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "build": {
    "appId": "dev.heynimbo.desktop",
    "productName": "HeyNimbo",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/brand",
        "to": "brand",
        "filter": [
          "*.png"
        ]
      },
      {
        "from": "../../THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "../../LICENSE",
        "to": "LICENSE"
      }
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "npmRebuild": false,
    "mac": {
      "target": [
        "dir"
      ],
      "icon": "build/brand/HeyNimbo.icns",
      "identity": "-",
      "hardenedRuntime": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "HeyNimbo uses your microphone when you ask by voice. Speech is processed on this Mac, or sent to OpenAI when you have saved an OpenAI API key.",
        "NSSpeechRecognitionUsageDescription": "HeyNimbo transcribes your voice questions on this Mac when you hold Control + Option. Built-in speech never sends your audio to a server."
      },
      "category": "public.app-category.productivity"
    }
  },
  "description": "A screen-aware voice and drawing guide for macOS."
}
